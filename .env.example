# Configure in Render, never in GitHub.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_CHAT_ID=0
# Firebase's PUBLIC web-client project identifier, not an ElevenLabs private API key.
# Must match ElevenLabs' current production web app. Deployment already configured.
ELEVENLABS_FIREBASE_API_KEY=
MAX_BATCH_ACCOUNTS=100
# Render supplies RENDER_EXTERNAL_URL automatically.
# PUBLIC_BASE_URL=https://your-service.onrender.com

# Encrypted, durable recovery (configure all four together).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generated Fernet key. Keep in Render only; do not rotate during unfinished work.
CHECKPOINT_ENCRYPTION_KEY=
# Independent secret for Supabase's due-job scheduler (not the Telegram secret).
JOB_WAKEUP_SECRET=
