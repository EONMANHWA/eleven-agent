# Set these in Render's Environment page. Do not put real values in GitHub.
TELEGRAM_BOT_TOKEN=
# Use a unique 32–256 character random URL-safe secret, NOT your bot token.
TELEGRAM_WEBHOOK_SECRET=
# Leave 0 for initial /id setup. Set your ID and redeploy before /login.
ADMIN_CHAT_ID=0
# Render supplies RENDER_EXTERNAL_URL automatically. Only override if necessary.
# PUBLIC_BASE_URL=https://your-service.onrender.com
# Optional audit log (leave BOTH unset to disable)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional, NOT promised free on Render. Static reCAPTCHA grids only.
NOPECHA_API_KEY=

# Sequential batch size (1–1000); defaults to 100, no parallel account logins.
MAX_BATCH_ACCOUNTS=100
# Absolute batch window from initial session claim (20–720 minutes).
# The 10-minute inactivity timeout still applies.
BATCH_SESSION_MINUTES=240

# Lower browser overhead on small hosts. Does NOT guarantee 512 MB is sufficient.
LOW_MEMORY_MODE=1
